{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/*.ts"],
  "exclude": ["src/client"]
}
